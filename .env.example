# Claude AI
ANTHROPIC_API_KEY=tu_api_key_aqui

# Firebase Admin SDK
FIREBASE_PROJECT_ID=tu-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\ntu_clave_privada\n-----END PRIVATE KEY-----\n"

# Firebase Web App (SDK de cliente, para el login de Google del admin) —
# valores públicos, se toman de Configuración del proyecto > Tus apps > Config
NEXT_PUBLIC_FIREBASE_API_KEY=tu_api_key_aqui
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=tu_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=tu_app_id

# Deepgram (transcripción de audio con timestamps por palabra)
DEEPGRAM_API_KEY=tu_api_key_aqui

# Pexels (banco de video/fotos de stock gratuito, para /video-letra)
PEXELS_API_KEY=tu_api_key_aqui

# Servidor
PORT=3001
